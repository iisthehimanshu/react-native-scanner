<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Declared here so the host app inherits them, but the host must still
    request the runtime ones before scanning. `neverForLocation` is not set:
    beacon RSSI is used to derive the user's position, which is exactly the
    inference that flag asserts is not happening.
  -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

  <!-- Pre-31 devices gate BLE scanning on the legacy Bluetooth permissions. -->
  <uses-permission
      android:name="android.permission.BLUETOOTH"
      android:maxSdkVersion="30" />
  <uses-permission
      android:name="android.permission.BLUETOOTH_ADMIN"
      android:maxSdkVersion="30" />

  <uses-feature
      android:name="android.hardware.bluetooth_le"
      android:required="false" />

  <!--
    The page's "Scan nearby QR" opens the camera inside the WebView.
    react-native-webview asks for it at runtime the first time the page does,
    but only when the manifest declares it; without this the page gets
    "NotAllowedError: Permission denied". Not required, so devices without a
    camera can still install the host app.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature
      android:name="android.hardware.camera"
      android:required="false" />

</manifest>
